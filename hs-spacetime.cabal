cabal-version:      3.0
name:               hs-spacetime
version:            0.1.0.0
synopsis:           Native Haskell client SDK for SpacetimeDB (v2 protocol)
license:            MIT
build-type:         Simple

flag wasm
  description: Build the wasm-only server ABI module and example reactor.
  default:     False
  manual:      True

common warnings
  ghc-options: -Wall

library bsatn
  import:           warnings
  visibility:       public
  hs-source-dirs:   bsatn/src
  default-language: Haskell2010
  exposed-modules:  SpacetimeDB.BSATN.Decoder
                    SpacetimeDB.BSATN.Encoder
                    SpacetimeDB.BSATN.Types
  build-depends:    base >=4.14 && <5, bytestring, text, wide-word

library
  import:           warnings
  -- The native client library links brotli/zlib and pulls network/websockets/
  -- wuss, none of which cross-compile to wasm32-wasi. Under +wasm it is not
  -- buildable, so an external wasm reactor depending on
  -- hs-spacetime:spacetime-server never drags the client library (or its brotli
  -- pkg-config solve check) into the build plan. Native builds (wasm off) are
  -- unaffected: the client lib + its Server.* re-exports build as before.
  if flag(wasm)
    buildable: False
  hs-source-dirs:   src
  default-language: Haskell2010
  exposed-modules:  SpacetimeDB
                    SpacetimeDB.Protocol.RowList
                    SpacetimeDB.Protocol.Messages
                    SpacetimeDB.Protocol.Frame
                    SpacetimeDB.Client.Endpoint
                    SpacetimeDB.Client.Types
                    SpacetimeDB.Client.State
                    SpacetimeDB.Client.Dispatch
                    SpacetimeDB.Client.Connection
                    SpacetimeDB.Client
                    SpacetimeDB.Client.Typed
                    SpacetimeDB.Codegen.Schema
                    SpacetimeDB.Codegen
  reexported-modules: SpacetimeDB.BSATN.Decoder
                    , SpacetimeDB.BSATN.Encoder
                    , SpacetimeDB.BSATN.Types
                    , SpacetimeDB.Server
                    , SpacetimeDB.Server.Types
                    , SpacetimeDB.Server.Schema
                    , SpacetimeDB.Server.SpacetimeType
                    , SpacetimeDB.Server.Table
                    , SpacetimeDB.Server.Reducer
                    , SpacetimeDB.Server.HKD
                    , SpacetimeDB.Server.Derive
                    , SpacetimeDB.Server.Internal
                    , SpacetimeDB.Server.Dispatch
  build-depends:    base >=4.14 && <5
                  , bsatn
                  , spacetime-server
                  , bytestring
                  , text
                  , containers
                  , wide-word
                  , stm
                  , async
                  , websockets
                  , wuss
                  , network
                  , zlib
                  , brotli
                  , aeson
                  , scientific
                  , vector
                  , unordered-containers
                  , case-insensitive

library spacetime-client-core
  import:           warnings
  visibility:       public
  hs-source-dirs:   src
  default-language: Haskell2010
  exposed-modules:  SpacetimeDB.Protocol.Messages
                    SpacetimeDB.Protocol.RowList
                    SpacetimeDB.Client.Endpoint
                    SpacetimeDB.Client.Types
                    SpacetimeDB.Client.State
                    SpacetimeDB.Client.Dispatch
  build-depends:    base >=4.14 && <5
                  , bsatn
                  , bytestring
                  , text
                  , containers
                  , wide-word

library spacetime-server
  import:           warnings
  visibility:       public
  hs-source-dirs:   server/src
  default-language: Haskell2010
  exposed-modules:  SpacetimeDB.Server
                    SpacetimeDB.Server.Types
                    SpacetimeDB.Server.Dispatch
                    SpacetimeDB.Server.Internal
                    SpacetimeDB.Server.Schema
                    SpacetimeDB.Server.SpacetimeType
                    SpacetimeDB.Server.Table
                    SpacetimeDB.Server.Reducer
                    SpacetimeDB.Server.HKD
                    SpacetimeDB.Server.Derive
  build-depends:    base >=4.14 && <5, bytestring, text, bsatn
  if flag(wasm)
    exposed-modules: SpacetimeDB.Server.ABI
    c-sources:       server/cbits/spacetime_abi.c
    include-dirs:    server/cbits
    install-includes: spacetime_abi.h

executable hs-spacetime-codegen
  import:           warnings
  -- Depends on the native client library, which is unbuildable under +wasm.
  if flag(wasm)
    buildable: False
  hs-source-dirs:   app
  main-is:          Codegen.hs
  default-language: Haskell2010
  build-depends:    base, hs-spacetime, bytestring, text

executable person-module-example
  import:           warnings
  default-language: Haskell2010
  hs-source-dirs:   server/example
  main-is:          PersonModule.hs
  if !flag(wasm)
    buildable: False
  if flag(wasm)
    build-depends:  base, bytestring, text, bsatn, spacetime-server
    ghc-options:    -no-hs-main -optl-mexec-model=reactor
                    -optl-Wl,--export=__describe_module__
                    -optl-Wl,--export=__call_reducer__
                    -optl-Wl,--export=_initialize
                    -optl-Wl,--export-memory

executable widget-module-example
  import:           warnings
  default-language: Haskell2010
  hs-source-dirs:   server/example
  main-is:          WidgetModule.hs
  if !flag(wasm)
    buildable: False
  if flag(wasm)
    build-depends:  base, bytestring, text, bsatn, spacetime-server
    ghc-options:    -no-hs-main -optl-mexec-model=reactor
                    -optl-Wl,--export=__describe_module__
                    -optl-Wl,--export=__call_reducer__
                    -optl-Wl,--export=_initialize
                    -optl-Wl,--export-memory

test-suite hs-spacetime-test
  import:           warnings
  -- Depends on the native client library, which is unbuildable under +wasm.
  if flag(wasm)
    buildable: False
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test test/golden
  main-is:          Spec.hs
  default-language: Haskell2010
  other-modules:    Generated
                    SpacetimeDB.IntegrationCheck
                    SpacetimeDB.Live.Harness
                    SpacetimeDB.Codegen.SchemaSpec
                    SpacetimeDB.Codegen.GoldenSpec
                    SpacetimeDB.Codegen.GeneratedRoundtripSpec
                    SpacetimeDB.BSATN.DecoderSpec
                    SpacetimeDB.BSATN.EncoderSpec
                    SpacetimeDB.BSATN.RoundtripSpec
                    SpacetimeDB.BSATN.TypesSpec
                    SpacetimeDB.Protocol.RowListSpec
                    SpacetimeDB.Protocol.MessagesSpec
                    SpacetimeDB.Protocol.FrameSpec
                    SpacetimeDB.Client.EndpointSpec
                    SpacetimeDB.Client.StateSpec
                    SpacetimeDB.Client.DispatchSpec
                    SpacetimeDB.Client.ConnectionSpec
                    SpacetimeDB.Client.TypedSpec
                    SpacetimeDB.Server.DispatchSpec
                    SpacetimeDB.Server.SchemaSpec
                    SpacetimeDB.Server.SpacetimeTypeSpec
                    SpacetimeDB.Server.TableSpec
                    SpacetimeDB.Server.HKDSpec
                    SpacetimeDB.Server.DeriveSpec
  build-depends:    base, hs-spacetime, spacetime-server, hspec, QuickCheck
                  , bytestring, text, containers, wide-word, zlib, stm, process

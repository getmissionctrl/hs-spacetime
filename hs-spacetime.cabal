cabal-version:      3.0
name:               hs-spacetime
version:            0.1.0.0
synopsis:           Native Haskell client SDK for SpacetimeDB (v2 protocol)
license:            MIT
build-type:         Simple

common warnings
  ghc-options: -Wall

library
  import:           warnings
  hs-source-dirs:   src
  default-language: Haskell2010
  exposed-modules:  SpacetimeDB
                    SpacetimeDB.BSATN.Decoder
                    SpacetimeDB.BSATN.Encoder
                    SpacetimeDB.BSATN.Types
                    SpacetimeDB.Protocol.RowList
                    SpacetimeDB.Protocol.Messages
                    SpacetimeDB.Protocol.Frame
                    SpacetimeDB.Client.Endpoint
                    SpacetimeDB.Client.Types
                    SpacetimeDB.Client.State
                    SpacetimeDB.Client.Dispatch
                    SpacetimeDB.Client.Connection
                    SpacetimeDB.Client
  build-depends:    base >=4.14 && <5
                  , bytestring
                  , text
                  , containers
                  , wide-word
                  , stm
                  , async
                  , websockets
                  , wuss
                  , network
                  , zlib
                  , brotli
                  , aeson
                  , scientific
                  , vector
                  , unordered-containers
                  , case-insensitive

test-suite hs-spacetime-test
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Spec.hs
  default-language: Haskell2010
  other-modules:    SpacetimeDB.BSATN.DecoderSpec
                    SpacetimeDB.BSATN.EncoderSpec
                    SpacetimeDB.BSATN.RoundtripSpec
                    SpacetimeDB.BSATN.TypesSpec
                    SpacetimeDB.Protocol.RowListSpec
                    SpacetimeDB.Protocol.MessagesSpec
                    SpacetimeDB.Protocol.FrameSpec
                    SpacetimeDB.Client.EndpointSpec
                    SpacetimeDB.Client.StateSpec
                    SpacetimeDB.Client.DispatchSpec
                    SpacetimeDB.Client.ConnectionSpec
  build-depends:    base, hs-spacetime, hspec, QuickCheck
                  , bytestring, text, containers, wide-word, zlib

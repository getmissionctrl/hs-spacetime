cabal-version:      3.0
name:               chat-module
version:            0.1.0.0
synopsis:           quickstart-chat example SpacetimeDB server module (Haskell)
license:            MIT
build-type:         Simple

flag wasm
  description: Build the wasm-only reactor for this example module.
  default:     False
  manual:      True

common extensions
  default-language:   GHC2021
  default-extensions: DataKinds
                      DeriveAnyClass
                      DeriveGeneric
                      DerivingStrategies
                      DuplicateRecordFields
                      FlexibleInstances
                      OverloadedRecordDot
                      OverloadedStrings
                      StandaloneDeriving
                      TypeFamilies
                      TypeApplications
                      NoFieldSelectors

library
  import:           extensions
  hs-source-dirs:   src
  exposed-modules:  Chat
  build-depends:    base
                  , text
                  , hs-spacetime:spacetime-server
                  , hs-spacetime:bsatn
  ghc-options:      -Wall

test-suite chat-module-test
  import:           extensions
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Spec.hs
  other-modules:    ChatSpec
                  , FakeBackend
  build-tool-depends: hspec-discover:hspec-discover
  build-depends:    base
                  , text
                  , bytestring
                  , containers
                  , hs-spacetime:spacetime-server
                  , hs-spacetime:bsatn
                  , chat-module
                  , hspec
  ghc-options:      -Wall

-- WASI-free wasm reactor. Mirrors the person-module-example stanza in
-- hs-spacetime.cabal: the reactor wrapper (app/ChatModule.hs) re-exports the
-- ABI entry points over Chat.chatModule.
executable chat-module
  import:           extensions
  hs-source-dirs:   app
  main-is:          ChatModule.hs
  if !flag(wasm)
    buildable: False
  if flag(wasm)
    build-depends:  base
                  , text
                  , hs-spacetime:spacetime-server
                  , hs-spacetime:bsatn
                  , chat-module
    ghc-options:    -no-hs-main -optl-mexec-model=reactor
                    -optl-Wl,--export=__describe_module__
                    -optl-Wl,--export=__call_reducer__
                    -optl-Wl,--export=_initialize
                    -optl-Wl,--export-memory
